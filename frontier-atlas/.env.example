# FrontierAtlas Environment Configuration
# Copy to .env and fill in credentials as needed. Never commit .env to version control.

# --- Primary LLM Provider (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# --- Optional Fallback LLM Providers (used only when keys are configured) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Storage (SQLite for local dev, PostgreSQL DSN for production scaling) ---
DATABASE_URL=sqlite:///data/frontier_atlas.db

# --- External Data APIs ---
# Optional GitHub Personal Access Token for higher rate limits when fetching repository stars
GITHUB_TOKEN=

# --- Google Sheets Export ---
# Path to Google Service Account JSON key file
GOOGLE_SHEETS_CREDENTIALS_PATH=
# Existing Spreadsheet ID (leave blank to create a new spreadsheet during export)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SPREADSHEET_NAME=FrontierAtlas Intelligence

# --- Crawler & Concurrency Controls ---
USER_AGENT=FrontierAtlasBot/1.0 (+https://github.com/frontier-atlas)
MAX_CONCURRENCY=8
REQUEST_TIMEOUT_SECONDS=20
RATE_LIMIT_PER_SECOND=2.0
RESPECT_ROBOTS_TXT=true
PLAYWRIGHT_ENABLED=false

# --- Pipeline & Logging ---
FRESHNESS_WINDOW_HOURS=24
LOG_LEVEL=INFO
ENABLE_LIVE_TESTS=false
